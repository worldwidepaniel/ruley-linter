{
  "meta": {
    "maxNesting": 5,
    "maxCssFiles": 1,
    "allowCdnFonts": false,
    "allowInlineStyles": false,
    "allowStyleTags": false,
    "allowExternalLinks": false,
    "requireLazyClassForImages": true
  },
  "tagValidators": [
    {
      "name": "maxAltLength",
      "type": "maxLength",
      "value": {
        "target": "alt",
        "value": 150
      },
      "allowedTags": ["img", "video"]
    },
    {
      "name": "dataOriginal",
      "type": "requiredAttribute",
      "value": {
        "value": "data-original"
      },
      "allowedTags": ["img"]
    },
    {
      "name": "allowedImgSrcs",
      "type": "allowedValues",
      "value": {
        "target": "data-original",
        "value": ["addr1", "addr2"]
      },
      "allowedTags": ["img"]
    },
    {
      "name": "requiredSrcValue",
      "type": "allowedValues",
      "value": {
        "target": "src",
        "value": ["https://example.com/blank.gif"]
      },
      "allowedTags": ["img"]
    }
  ]
}
